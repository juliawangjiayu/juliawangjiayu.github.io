{
  "name": "juliawangjiayu.github.io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "worker:dev": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply julia-photo-guess --local",
    "sync:game": "node scripts/sync-guess-where.mjs",
    "sync:ai-config": "node scripts/sync-ai-config.mjs",
    "test": "node --test tests/*.test.ts worker/tests/*.test.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/create-pages-fallback.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.1",
    "wrangler": "^4.151.3"
  }
}
